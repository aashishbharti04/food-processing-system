# ---------------------------------------------------------------------------
# Food Processing System — environment configuration
#
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database backend: "sqlite" (default, zero-config) or "mysql" (production).
DB_BACKEND=sqlite

# --- SQLite settings (used when DB_BACKEND=sqlite) -------------------------
# Path to the SQLite file. Use ":memory:" for an ephemeral in-memory database.
SQLITE_PATH=food.db

# --- MySQL settings (used when DB_BACKEND=mysql) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food

# --- UI -------------------------------------------------------------------
# Set to 1 to disable coloured output (https://no-color.org).
NO_COLOR=0
