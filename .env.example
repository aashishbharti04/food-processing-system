# ---------------------------------------------------------------------------
# Food Processing System — environment configuration
#
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database backend: "sqlite" (default, zero-config) or "mysql" (production).
DB_BACKEND=sqlite

# --- SQLite settings (used when DB_BACKEND=sqlite) -------------------------
# Path to the SQLite file. Use ":memory:" for an ephemeral in-memory database.
SQLITE_PATH=food.db

# --- MySQL settings (used when DB_BACKEND=mysql) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food

# --- CLI UI ----------------------------------------------------------------
# Set to 1 to disable coloured output (https://no-color.org).
NO_COLOR=0

# --- Web admin dashboard (optional, DB_BACKEND is shared with the CLI) ------
# Generate a strong key, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
WEB_HOST=127.0.0.1
WEB_PORT=5000
